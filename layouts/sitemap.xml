{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Pages }}
    {{ if and .Permalink (not .Params.noindex) (not .Params.canonical) (not (in (slice "taxonomy" "term" "404") .Kind)) }}
    <url>
      <loc>{{ .Permalink }}</loc>
      {{ range .AllTranslations }}
      <xhtml:link rel="alternate" hreflang="{{ .Site.Language.LanguageCode }}" href="{{ .Permalink }}" />
      {{ if eq .Lang "en" }}<xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}" />{{ end }}
      {{ end }}
      {{ if not .Lastmod.IsZero }}<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
    </url>
    {{ end }}
  {{ end }}
</urlset>
